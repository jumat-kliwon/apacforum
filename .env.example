# PostgreSQL
DATABASE_URL=postgres://apcr:apcr@localhost:5432/apcr

# Public site URL (links in emails, DOKU callback and notification URLs)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# First admin (used by `bun run db:seed`)
SEED_ADMIN_EMAIL=admin@apcrforum.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=APCR Admin

# DOKU Checkout — sandbox: https://api-sandbox.doku.com, production: https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com

# Email (SMTP). Empty = emails are only logged.
SMTP_URL=
MAIL_FROM=APCR <no-reply@apcrforum.com>

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
NUXT_PUBLIC_R2_PUBLIC_URL=
